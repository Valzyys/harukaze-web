# Harukaze48 — Partner signer (OshiGO)
# Salin ke signer/.env lalu isi. JANGAN commit signer/.env.

# Kredensial partner dari dashboard OshiGO (Developer API)
PARTNER_KEY_ID=
PARTNER_SECRET=

# IP server tempat signer ini jalan — HARUS sama dengan IP yang di-whitelist
# di dashboard OshiGO. Kosongkan untuk auto-deteksi IP keluar (lalu daftarkan
# IP itu di dashboard). Wajib statis — ini alasan signer tidak ditaruh di
# Cloudflare Workers (IP-nya berganti-ganti).
PARTNER_SERVER_IP=

# Token rahasia antara Cloudflare Worker dan signer ini (bebas, acak panjang).
# Set nilai yang sama di Worker: `npx wrangler secret put SIGNER_TOKEN`.
SIGNER_TOKEN=

# Jarang diubah
PARTNER_BASE=https://st.oshigo.web.id
SITE_ORIGIN=https://harukaze48.my.id
HOST=127.0.0.1
PORT=8788
SESSION_TTL=120

# Opsional: kalau slug show di situs (slug IDN Plus) beda dengan show_slug OshiGO
# dan kamu hanya punya satu show, isi show_slug OshiGO di sini sebagai fallback.
SHOW_SLUG_FALLBACK=
