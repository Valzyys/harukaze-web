{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harukaze-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 tanpa database_id → wrangler membuat database & memasang binding
  // otomatis saat `wrangler deploy` pertama. Tabel dibuat otomatis oleh Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harukaze-db",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PARTNER_ORIGIN": "https://st.oshigo.web.id"
    // Opsional: PARTNER_SERVER_IP (IP yang di-whitelist OshiGO), SHOW_SLUG_FALLBACK
  }
  // Login admin default: kaze / haru (bisa ditimpa: ADMIN_USERNAME, ADMIN_PASSWORD)
  // Secret stream (wajib): PARTNER_KEY_ID, PARTNER_SECRET  — signer sudah di dalam Worker ini.
  //   npx wrangler secret put PARTNER_KEY_ID
  //   npx wrangler secret put PARTNER_SECRET
  // Opsional: APP_SECRET
}
